<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Join ezsplit</title>
  <style>
    body { margin: 0; background: #FFF6DC; color: #111; font-family: system-ui, sans-serif; }
    main { max-width: 420px; margin: 0 auto; padding: 48px 20px; }
    h1 { font-size: 28px; }
    a.button { display: block; text-align: center; padding: 14px; font-weight: 700; color: #111; text-decoration: none;
               background: #EF9F27; border: 2.5px solid #111; border-radius: 12px; box-shadow: 4px 4px 0 #111; }
    p { line-height: 1.5; }
  </style>
</head>
<body>
  <main>
    <h1>You're invited to ezsplit</h1>
    <p>Open the invite in the ezsplit app to set up your account.</p>
    <p><a class="button" href="<%= @app_url %>">Open in ezsplit</a></p>
    <p>Nothing happened? Open the ezsplit app, tap "Have an invite link?", and paste this page's link.</p>
  </main>
</body>
</html>
