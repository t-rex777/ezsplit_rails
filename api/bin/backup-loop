#!/usr/bin/env bash
set -euo pipefail

db=/rails/storage/production.sqlite3
dest=/backups
mkdir -p "$dest"

while true; do
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  target="$dest/production-$stamp.sqlite3"
  sqlite3 "$db" ".backup '$target'"
  echo "backup: wrote $target"
  find "$dest" -name 'production-*.sqlite3' -mmin +20160 -delete
  sleep 86400
done
