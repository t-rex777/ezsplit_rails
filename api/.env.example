# Copy to api/.env and fill in. api/.env is ignored by git; never commit it.

# Address phones use to reach this Mac (bin/lan-server fills it in when blank).
APP_HOST=
APP_PORT=3100

# Real email. Gmail: turn on 2-step verification, then make an app password at
# https://myaccount.google.com/apppasswords and paste it below (no spaces).
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=
# Optional; defaults to SMTP_USERNAME.
MAIL_FROM=

# Docker + ngrok production stack (docker compose up --build -d).
# Generate SECRET_KEY_BASE with: openssl rand -hex 64
SECRET_KEY_BASE=
APP_HOST=
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Optional off-site SQLite backup with Litestream (S3-compatible bucket).
BUCKET_NAME=
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
